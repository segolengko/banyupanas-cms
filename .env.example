# Public site URL used for metadata and canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key

# Admin authentication
CMS_ADMIN_EMAIL=admin@banyupanascirebon.id
CMS_ADMIN_PASSWORD_HASH=scrypt:replace_with_generated_hash
CMS_SESSION_SECRET=replace_with_a_random_32_plus_character_secret

# Secure server-side CMS backend
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
